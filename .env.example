# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traffic_accidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traffic_accidents
SQLITE_FALLBACK_PATH=data/traffic_accidents.db

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=traffic-accident-severity-prediction

# FastAPI Model Serving
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/accident_severity_model.joblib

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_HOME=./airflow
